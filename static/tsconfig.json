{
    "compilerOptions": {
        "target": "es6",
        "module": "es2020",
        "lib": ["es2016", "es2017.object", "dom", "dom.iterable"],
        "types": [],
        "allowJs": true,
        "checkJs": true,
        "declaration": true,
        "strict": false,
        "noImplicitThis": true,
        "emitDeclarationOnly": true,
        "strictFunctionTypes": true,
        "strictBindCallApply": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true
    },
    "files": [
        "protocol.js",
        "settings.js",
        "filter.js",
        "camera-test.js",
        "room-tools.js",
        "galene.js",
        "management.js",
        "example/example.js"
    ]
}
